# Callit environment. Copy to .env.local for local dev.
# On Vercel: Project → Settings → Environment Variables. "server only" = never prefix with NEXT_PUBLIC_.
# Optional values can stay empty: the feature that needs them simply stays off.

# ── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.callit.buzz
PUBLIC_SITE_URL=https://www.callit.buzz
NEXT_PUBLIC_X_URL=                      # e.g. https://x.com/CallitApp_Sol
NEXT_PUBLIC_WALLET_CONFIRM=                # 1 = show Privy's confirm window for in-app wallets. Empty = sign instantly (Phantom etc. still ask)
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
ADMIN_HANDLES=                          # comma separated Callit handles with admin panel access
ADMIN_WALLETS=                          # or wallet addresses

# ── Supabase (database, storage, realtime) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=              # server only

# ── Privy (sign-in + embedded wallets) ───────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=                       # server only

# ── Solana + market data ─────────────────────────────────────────────
HELIUS_API_KEY=                         # server only
SOLANA_RPC_URL=                         # optional, overrides Helius
HELIUS_WEBHOOK_ID=
HELIUS_WEBHOOK_SECRET=
JUPITER_API_KEY=                        # optional, higher rate limits (portal.jup.ag)

# ── Private Withdraw (Privacy Cash shielded pool, mainnet only) ──────
NEXT_PUBLIC_PRIVATE_WITHDRAW=           # empty/off = "coming soon", beta = only PRIVATE_BETA_WALLETS, on = everyone
PRIVATE_BETA_WALLETS=                   # comma separated wallet addresses that get Private Withdraw in beta (shared by both privacy rails)
NEXT_PUBLIC_PRIVACYCASH_REFERRAL_ID=    # optional partner id from Privacy Cash, earns a share of withdraw fees
PRIVATE_FEE_USD=0.4                     # Callit's privacy fee per add-funds, paid in SOL to TREASURY_WALLET (no treasury = no fee)

# ── Private Withdraw rail #2 (Helius Privacy Rings, mainnet, SOL only) ──
NEXT_PUBLIC_HELIUS_PRIVACY=             # empty/off = hidden, beta = PRIVATE_BETA_WALLETS + admins, on = everyone
HELIUS_GAS_WALLET_SECRET=               # server only: FRESH wallet with a little SOL (~0.05); pays withdrawal fees so users' wallets never appear. Unset = private sends paused
HELIUS_PRIVATE_FEE_USD=                 # Callit protocol fee per Helius add-funds, in USD (e.g. 0.1). Empty/0 = no fee. Needs TREASURY_WALLET
NEXT_PUBLIC_VERIFIED_HANDLES=           # handles with the Verified checkmark, comma separated (callit is always verified)
NEXT_PUBLIC_CALL_VOLUME=                # public = everyone sees what each call brought in; empty = only the caller
FEEDBACK_POINTS=25                      # points for a piece of feedback an admin marks valid (0 = off)
NEXT_PUBLIC_PRIVATE_SWAP=               # soon = show the "Private swap — coming soon" switch in Swap settings

# ── Trading fee (Jupiter referral). Set BOTH or neither. ─────────────
JUPITER_REFERRAL_ACCOUNT=
JUPITER_REFERRAL_FEE_BPS=100

# ── Payouts: callers paid when a call hits target ────────────────────
PAYOUTS_ON=                             # 1 to enable
AUTO_PAYOUTS=                           # 1 = pay automatically every minute
PAYOUT_WALLET_SECRET=                   # server only: key of a FRESH wallet holding only payout SOL
PAYOUT_MIN_USD=0.05
PAYOUT_MAX_CLAIM_USD=                   # empty = no cap (emergency brake only)
PAYOUT_DAILY_CAP_USD=                   # empty = no cap (emergency brake only)
CRON_SECRET=                            # server only: shared with the cron jobs
CASHBACK_MIN_POINTS=1000
MOONSHOT_MIN_MC=250000                  # 25X+ milestone points need the token to reach this MC (USD)
MONTHLY_REWARDS_ON=
MONTHLY_REWARDS_TOP=50

# ── Public wallets shown on the Transparency page (addresses only) ───
TREASURY_WALLET=
BUYBACK_WALLET=

# ── Chat + calls ─────────────────────────────────────────────────────
CHAT_KEY=                               # server only: 64 hex chars. Never change once set.
GIPHY_API_KEY=                          # GIF search (or TENOR_API_KEY)
TENOR_API_KEY=
TURN_URLS=                              # optional TURN relay for calls on mobile data
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Push notifications (Web Push) ────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                      # server only
VAPID_SUBJECT=mailto:you@example.com

# ── Telegram ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                     # server only, from @BotFather
TELEGRAM_BOT_USERNAME=
TELEGRAM_REPLY=                         # 0 = bot doesn't reply in groups
TG_TRADING_ON=                          # 1 = trading bot on (keep off until ready)
BOT_WALLET_KEY=                         # server only: 32+ random bytes. Never change once set.
TG_MAX_BUY_SOL=5

# ── Optional extras ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=                      # SI Assistant (server only)
ASSISTANT_MODEL=
ASSISTANT_DAILY_LIMIT=
SI_ASSISTANT=
RESEND_API_KEY=                         # welcome email
EMAIL_FROM=Callit <hello@yourdomain.com>
X_BEARER_TOKEN=                         # news from X
YOUTUBE_API_KEY=                        # news from YouTube
