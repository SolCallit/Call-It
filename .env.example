# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://call-it-chi.vercel.app

# Supabase (backend phase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never expose

# Privy (auth + embedded wallets)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=                   # server only

# Solana
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
HELIUS_API_KEY=                     # server only
